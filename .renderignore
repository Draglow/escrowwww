# Files and directories to ignore during Render deployment

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
*.cover

# Environment files
.env
.env.local
.env.*.local

# Database
*.sqlite3
*.db

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/

# Documentation (optional - remove if you want docs deployed)
*.md
!README.md

# Git
.git/
.gitignore
.gitattributes
