# Django Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://escrow_user:escrow_password_change_in_production@postgres:5432/escrow_db

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Tron Network
TRON_NETWORK=mainnet
TRONGRID_API_KEY=your-trongrid-api-key
TRON_FULL_NODE=https://api.trongrid.io
TRON_SOLIDITY_NODE=https://api.trongrid.io
TRON_EVENT_SERVER=https://api.trongrid.io

# Encryption
WALLET_ENCRYPTION_KEY=your-32-byte-base64-encryption-key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Platform Settings
PLATFORM_FEE_PERCENTAGE=2.5
MIN_DEAL_AMOUNT=10.00
MAX_DEAL_AMOUNT=100000.00

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Escrow Platform
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
