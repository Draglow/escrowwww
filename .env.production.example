# Production Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# Django Settings
# ============================================
DEBUG=False
SECRET_KEY=change-this-to-a-random-50-character-string
ALLOWED_HOSTS=api.escrow.example.com,escrow.example.com
CORS_ALLOWED_ORIGINS=https://escrow.example.com
CSRF_TRUSTED_ORIGINS=https://escrow.example.com,https://api.escrow.example.com

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=escrow_prod
POSTGRES_USER=escrow
POSTGRES_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql://escrow:change-this-strong-password@localhost:5432/escrow_prod

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=change-this-strong-redis-password
REDIS_URL=redis://:change-this-strong-redis-password@localhost:6379/0
CELERY_BROKER_URL=redis://:change-this-strong-redis-password@localhost:6379/1

# ============================================
# Tron Blockchain Configuration
# ============================================
# Get API key from https://www.trongrid.io/
TRON_API_KEY=your-trongrid-api-key-here
TRON_NETWORK=mainnet
# For testing, use: TRON_NETWORK=shasta

# ============================================
# Platform Settings
# ============================================
PLATFORM_FEE_PERCENTAGE=2.5

# ============================================
# Telegram Configuration
# ============================================
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
NEXT_PUBLIC_TELEGRAM_BOT_NAME=YourEscrowBot

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=https://api.escrow.example.com
NEXT_PUBLIC_WS_URL=wss://api.escrow.example.com

# ============================================
# Security Settings
# ============================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================
# Monitoring & Error Tracking
# ============================================
# Sign up at https://sentry.io for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# Email Configuration (Optional)
# ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@escrow.example.com

# ============================================
# AWS S3 Configuration (Optional - for media files)
# ============================================
# USE_S3=True
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# ============================================
# Backup Configuration
# ============================================
BACKUP_RETENTION_DAYS=30

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_GENERAL=100/m
RATE_LIMIT_AUTH=10/m
RATE_LIMIT_WITHDRAWAL=5/m

# ============================================
# Notes
# ============================================
# 1. Generate SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 2. Use strong passwords for database and Redis
# 3. Get Tron API key from https://www.trongrid.io/
# 4. Create Telegram bot via @BotFather
# 5. Setup Sentry for production error tracking
# 6. Replace all example.com with your actual domain
# 7. Never commit this file to version control
